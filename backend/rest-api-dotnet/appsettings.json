{
  "MySQLConnection": {
    "MySQLConnectionString": "Server=db_server;Database=database_name;Uid=user;Pwd=password;SslMode=none;"
  },
  "TokenConfiguration": {
    "Audience": "your_Audience",
    "Issuer": "your_issuer",
    "Secret": "your_secret",
    "Minutes": 60,
    "DaysToExpire": 7
  },
  "ExternalAuthConfiguration": {
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "GoogleAuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "GoogleValidateTokenEndpoint": "https://oauth2.googleapis.com/tokeninfo?id_token=",
    "RedirectUri": "https://your-api/callback",
    "FrontendRedirectUrl": "https://frontend-redirect-url/callback"
  },
  "CorsConfiguration": {
    "AllowedOrigins": [
      "http://localhost"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
